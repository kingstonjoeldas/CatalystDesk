# Hugging Face Inference API
# Get token: https://huggingface.co/settings/tokens
HF_TOKEN=hf_YOUR_TOKEN_HERE
HF_CACHE_DIR=./cache/hf
HF_HOME=./cache/hf

# FRED Economic Data (Optional)
# Get key: https://fred.stlouisfed.org/docs/api/api_key.html
# If missing, FRED ingest is skipped gracefully
FRED_API_KEY=

# Cache Configuration
CACHE_DIR=./cache
CACHE_BACKEND=sqlite  # Options: sqlite, none

# Logging
LOG_LEVEL=INFO
LOG_DIR=./logs

# Chroma Vector DB
CHROMA_DB_DIR=./data/chroma

# Evaluation Traces
TRACE_DB=./data/traces.db

# Data Sources (URLs, optional overrides)
# GDELT_GKG_URL=https://...
# RSS_FEEDS=https://example.com/feed1,https://example.com/feed2

# Agent Configuration (L5+)
LLM_TIMEOUT_SEC=30
RETRY_ATTEMPTS=3
RETRY_BACKOFF_SEC=2
